{
  "name": "character-sheet",
  "version": "2.1.0",
  "description": "DnD 5e Player Companion",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "build:ios": "electron-vite build && cap sync ios",
    "cap:sync": "cap sync",
    "cap:open": "cap open ios",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.charactersheet.app",
    "productName": "Character Sheet",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "src/renderer/public/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjdelacuadra/Character_sheet.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cjdelacuadra/Character_sheet/issues"
  },
  "homepage": "https://github.com/cjdelacuadra/Character_sheet#readme",
  "devDependencies": {
    "@capacitor/cli": "^7.6.6",
    "@capacitor/ios": "^7.6.6",
    "@electron/asar": "^4.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.6",
    "@capacitor/filesystem": "^7.1.8",
    "@dnd-kit/core": "^6.3.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  }
}
